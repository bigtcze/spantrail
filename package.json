{
  "name": "spantrail-correlation-proof",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node experiments/source-attribution/build.js",
    "test": "npm run test:unit && npm run test:express && npm run test:capture && npm run proof && npm run proof:express && npm run test:viewer:express && npm run test:viewer",
    "test:capture": "node --test experiments/capture/*.test.js",
    "pretest:unit": "npm run build",
    "test:unit": "node --test experiments/correlation/*.test.js experiments/source-attribution/*.test.js experiments/viewer/*.test.js experiments/demo/*.test.js",
    "pretest:express": "npm run build",
    "test:express": "node --test experiments/express/*.test.js",
    "preproof": "npm run build",
    "proof": "node experiments/correlation/run.js",
    "test:viewer": "node experiments/viewer/e2e.js",
    "preproof:express": "npm run build",
    "proof:express": "node experiments/express/run.js",
    "test:viewer:express": "SPANTRAIL_ARTIFACT_PATH=experiments/express/artifacts/express-proof.json node experiments/viewer/e2e.js",
    "viewer": "node experiments/viewer/server.js",
    "demo": "node experiments/demo/run.js"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/node": "24.10.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "express": "5.2.1",
    "playwright": "1.63.0"
  }
}
